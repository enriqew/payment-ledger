# Copy to .env and fill in. .env is gitignored.

# Optional. Left unset, the receiver asks the CLI for it (`stripe listen --print-secret`),
# which is the same value the listener signs with. Set it only to pin a specific secret.
# STRIPE_WEBHOOK_SECRET=whsec_...

# The receiver starts `stripe listen` itself. Set to 0 to run the listener in its own terminal.
CAPTURE_SPAWN_LISTEN=1

# Where the receiver listens. Must match the --forward-to above.
CAPTURE_HOST=127.0.0.1
CAPTURE_PORT=4242

# Reject payloads whose signature timestamp is older than this, in seconds.
# Stripe's own recommended default is 300.
WEBHOOK_TOLERANCE_SECONDS=300

# Captured payloads land here, one file per event id.
FIXTURES_DIR=fixtures/events

# Local stack (phase 1 onward)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=stripe.events.raw

ICEBERG_REST_URI=http://localhost:8181
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
WAREHOUSE_BUCKET=warehouse
