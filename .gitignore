# Secrets. This repository is public, so the list is deliberately wider than what the project
# uses today: the phases still to come add dbt profiles and Airflow connections, and the time to
# ignore those is before the file exists, not after it has been committed once.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
credentials.json
service-account*.json
dbt/profiles.yml
airflow/airflow.cfg
airflow/webserver_config.py
.stripe/

# a local copy of the stripe cli, so the capture runs without a system-wide install
.tools/

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# local stack state, and everything a generated run writes. A run is reproducible from its seed
# and its transaction count, so committing its output would be committing something recomputable.
warehouse/
data/
# What a dashboard reads. Recomputable from the same run as everything else in data/, and the
# contract that says what may be in it is the thing worth committing.
export/
logs/
spark-warehouse/
metastore_db/
derby.log

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# editors
.idea/
.vscode/
